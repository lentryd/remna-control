# Panel backend inside the docker network (direct, not through Traefik).
REMNAWAVE_URL=http://remnawave:3000
# Panel API token: Remnawave → API tokens. Scopes: users:*,
# internal-squads:read, nodes:read, bandwidth-stats:read,
# infra-billing:read (providers and payment dates from Infra Billing) — or *.
REMNAWAVE_TOKEN=
# Only if the panel sits behind caddy-with-auth (Auth Portal API key).
REMNAWAVE_API_KEY=

# Domain the app is served at (its own, e.g. a subdomain of the panel's).
APP_DOMAIN=control.example.com
# Host port the container is published on.
HOST_PORT=8080

# Docker deployment (compose.yml): the panel's docker network and
# Traefik's ACME resolver and entrypoints.
REMNAWAVE_NETWORK=remnawave-network
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINTS=web,websecure

# Signs admin session cookies. Generate: openssl rand -hex 32
JWT_SECRET=
# Set to false only for plain-http local runs.
SECURE_COOKIE=true

# Admins log in with their panel credentials. This local login is a fallback
# for panels with password login disabled (OAuth/passkeys only); empty = off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: Remnawave webhooks for instant cache updates. The panel only
# accepts https://, so set its WEBHOOK_URL to the public route
# https://$APP_DOMAIN/api/webhooks/remnawave and use the same value
# as its WEBHOOK_SECRET_HEADER here (requests are HMAC-signed with it).
WEBHOOK_SECRET=

# Optional add-ons file in subpage's addons.yml format (add-ons can also be
# managed in the UI). Host path that compose mounts read-only, e.g.
# ../subpage/addons.yml to share subpage's catalog.
ADDONS_FILE=./addons.yml
# Local (non-docker) path of the same file.
ADDONS_CONFIG=./addons.yml

DB_PATH=./data/vpn-control.db
PORT=8080
# Time zone dates are shown and periods are cut in, e.g. Europe/Moscow.
TZ=UTC
SYNC_INTERVAL=10m
# How often node traffic for metered (per-GB) expenses is pulled.
TRAFFIC_SYNC_INTERVAL=1h
# How often tariff params are pushed to panel users and due
# "by subscription" traffic resets are done.
PANEL_SYNC_INTERVAL=5m
DEBUG=false
